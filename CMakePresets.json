{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceParentDir}/miniqu-work/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "None" }
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Benchmarks: -O3, no assertions, no logging code, LTO",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O3 -DNDEBUG",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "release-clang",
      "inherits": "release",
      "description": "As release, compiled with clang++",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "description": "Development: -O0, assertions, logging code",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-O0 -g -DMINIQU_LOGGING" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "description": "Fuzzing: address and undefined behaviour sanitizers, assertions",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "log",
      "inherits": "base",
      "description": "Tracing a long run: optimised, logging code, no assertions",
      "cacheVariables": { "CMAKE_CXX_FLAGS": "-O2 -g -DNDEBUG -DMINIQU_LOGGING" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "release-clang", "configurePreset": "release-clang" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "log", "configurePreset": "log" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "release-clang", "configurePreset": "release-clang", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "log", "configurePreset": "log", "output": { "outputOnFailure": true } }
  ]
}
